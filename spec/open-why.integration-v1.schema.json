{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-why.dev/spec/open-why.integration-v1.schema.json",
  "title": "open-why integration manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "integration_id", "integration_version", "mode", "capabilities", "scope", "store_identity"],
  "properties": {
    "contract": { "const": "open-why.integration/v1" },
    "integration_id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9._:-]+$" },
    "integration_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "mode": { "enum": ["mcp-stdio", "rust-library"] },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["ask", "index", "capture", "import", "search", "current", "history", "commit-links", "link", "feedback"] }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strategy"],
      "properties": { "strategy": { "const": "explicit" } }
    },
    "store_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strategy", "environment"],
      "properties": {
        "strategy": { "const": "per-installation" },
        "environment": { "const": "OPEN_WHY_STORE_INSTANCE_ID" }
      }
    },
    "mcp": { "$ref": "#/$defs/mcp" },
    "rust": { "$ref": "#/$defs/rust" }
  },
  "allOf": [
    {
      "if": { "properties": { "mode": { "const": "mcp-stdio" } } },
      "then": { "required": ["mcp"], "not": { "required": ["rust"] } }
    },
    {
      "if": { "properties": { "mode": { "const": "rust-library" } } },
      "then": { "required": ["rust"], "not": { "required": ["mcp"] } }
    }
  ],
  "$defs": {
    "contracts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^open-why\\..+/v[0-9]+$" }
    },
    "mcp": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "args", "protocol_version", "contracts"],
      "properties": {
        "command": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "args": { "type": "array", "maxItems": 32, "items": { "type": "string", "maxLength": 1024 } },
        "protocol_version": { "type": "string", "minLength": 1, "maxLength": 32 },
        "contracts": { "$ref": "#/$defs/contracts" }
      }
    },
    "rust": {
      "type": "object",
      "additionalProperties": false,
      "required": ["crate_name", "minimum_version", "contracts"],
      "properties": {
        "crate_name": { "const": "open-why" },
        "minimum_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "contracts": { "$ref": "#/$defs/contracts" }
      }
    }
  }
}
